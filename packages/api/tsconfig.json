{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // vitest-plugin supplies the `cloudflare:test` module declaration the tests import.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "lib": ["ES2022"]
  },
  // Include Worker tests so broken test imports fail typechecking.
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"],
    },
    // Pure types and constants, reached through the package index.
    "packages/core": { "project": ["src/**/*.ts"] },
    "packages/shared": { "entry": ["src/**/*.test.ts"], "project": ["src/**/*.ts"] },
    "packages/api": {
      // The Worker entry comes from wrangler.toml's `main`, which knip reads for itself.
      "entry": ["src/**/*.test.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/web": {
      // The SPA entry comes from index.html, which knip reads for itself.
      "entry": ["src/**/*.test.{ts,tsx}", "e2e/**/*.spec.ts", "scripts/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/*.mjs"],
    },
  },
  // `cloudflare:test` is the vitest-pool-workers virtual module, not a package on disk.
  "ignoreDependencies": ["cloudflare"],
  // Plenty here is exported so a sibling test can reach it while still being used only inside its
  // own file. Reporting those buries the finding that matters: a symbol used nowhere at all.
  "ignoreExportsUsedInFile": true,
}

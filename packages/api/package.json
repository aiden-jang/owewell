{
  "name": "@owewell/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "owewell API on Cloudflare Workers (Hono + D1 + Durable Object realtime).",
  "scripts": {
    "dev": "wrangler dev --var AUTH_URL:http://localhost:34100",
    "deploy": "pnpm --filter @owewell/web build && pnpm run deploy:assets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply owewell --local",
    "deploy:assets": "wrangler d1 migrations apply owewell --remote && wrangler deploy"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.2.0",
    "@owewell/core": "workspace:*",
    "@owewell/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.152.0"
  }
}

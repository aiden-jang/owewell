{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}"],
      "project": ["scripts/*.{mjs,cjs}"],
    },
    // Pure types and constants, reached through the package index.
    "packages/core": { "project": ["src/**/*.ts"] },
    "packages/shared": { "entry": ["src/**/*.test.ts"], "project": ["src/**/*.ts"] },
    "packages/api": {
      // The Worker entry comes from wrangler.toml's `main`, which knip reads for itself.
      "entry": ["src/**/*.test.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/web": {
      // The SPA entry comes from index.html, which knip reads for itself.
      "entry": ["src/**/*.test.{ts,tsx}", "e2e/**/*.spec.ts", "scripts/*.{mjs,cjs}"],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts", "scripts/*.{mjs,cjs}"],
    },
  },
  // `cloudflare:test` is the vitest-plugin virtual module, not a package on disk.
  "ignoreDependencies": ["cloudflare"],
  // Include exports used only by their own file or tests; report symbols with no consumers.
  "ignoreExportsUsedInFile": true,
}

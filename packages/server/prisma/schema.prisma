// Owe Well database schema.
// Money is never stored here yet; that arrives with expenses in a later phase.
// All amounts, when they land, will be integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  // Email is stored already lowercased + trimmed by the app layer; uniqueness is case-sensitive at the DB.
  email        String    @unique
  passwordHash String
  displayName  String
  // A placeholder is a name-only person added to a group (no real login). They can
  // appear in splits/balances like anyone else, and be claimed by a real account later.
  isPlaceholder Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  createdGroups   Group[]
  memberships     GroupMember[]
  paidExpenses    Expense[]      @relation("ExpensePayer")
  createdExpenses Expense[]      @relation("ExpenseCreator")
  expenseSplits   ExpenseSplit[]
  itemShares      ExpenseItemShare[]

  settlementsFrom    Settlement[] @relation("SettlementFrom")
  settlementsTo      Settlement[] @relation("SettlementTo")
  createdSettlements Settlement[] @relation("SettlementCreator")
  invitesSent        Invite[]     @relation("InviteCreator")

  @@map("users")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum SplitMethod {
  EQUAL
  EXACT
  PERCENT
  SHARES
  ITEMIZED
}

model Group {
  id          String        @id @default(cuid())
  name        String
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invites     Invite[]

  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId     String
  payer       User           @relation("ExpensePayer", fields: [payerId], references: [id])
  createdById String
  createdBy   User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  description String
  // Always integer cents. amountCents is the grand total (items + tax + tip for ITEMIZED).
  amountCents Int
  splitMethod SplitMethod
  // Only meaningful for ITEMIZED expenses; 0 otherwise.
  taxCents    Int            @default(0)
  tipCents    Int            @default(0)
  createdAt   DateTime       @default(now())
  // Soft delete: keeps history and balances auditable.
  deletedAt   DateTime?
  splits      ExpenseSplit[]
  items       ExpenseItem[]

  @@index([groupId])
  @@map("expenses")
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  // What this participant owes, in integer cents. Always sums to the expense total.
  owedCents Int
  // Raw input that produced owedCents (EXACT: cents, PERCENT: basis points, SHARES: weight; null for EQUAL).
  inputValue Int?

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model ExpenseItem {
  id          String             @id @default(cuid())
  expenseId   String
  expense     Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  // The people on this item; it is split equally among them.
  shares      ExpenseItemShare[]

  @@index([expenseId])
  @@map("expense_items")
}

model ExpenseItemShare {
  id     String      @id @default(cuid())
  itemId String
  item   ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
  @@index([userId])
  @@map("expense_item_shares")
}

model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Who paid whom, in integer cents.
  fromUserId  String
  fromUser    User     @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("SettlementTo", fields: [toUserId], references: [id])
  amountCents Int
  // Who recorded it (either party may log a payment).
  createdById String
  createdBy   User     @relation("SettlementCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([groupId])
  @@map("settlements")
}

model Invite {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // The raw token lives in the share link; it is unique and unguessable.
  token       String    @unique
  // Optional: who the invite was addressed to (lowercased). Null = anyone with the link.
  email       String?
  invitedById String
  invitedBy   User      @relation("InviteCreator", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([groupId])
  @@map("invites")
}

model Session {
  // `id` holds the SHA-256 hash of the session token. The raw token lives only in the
  // user's cookie, never in the database, so a DB leak does not hand out live sessions.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

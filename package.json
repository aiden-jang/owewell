{
  "name": "owewell",
  "version": "0.0.0",
  "private": true,
  "description": "Split bills, settle up, keep friends.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @owewell/api dev",
    "dev:web": "pnpm --filter @owewell/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-classes": "pnpm --filter @owewell/web dead-classes",
    "deploy": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm dead-classes && pnpm test && pnpm run deploy:only",
    "deploy:only": "pnpm --filter @owewell/api run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
